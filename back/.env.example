DATABASE_URL=postgresql+asyncpg://nh_auth:nh_auth@localhost:5432/nh_auth

# Trivial local-dev value, fine to commit (same reasoning as DATABASE_URL
# above) — generate a real one for the deployed backend instead:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=local-dev-secret-not-for-production

# front/'s dev URL (ssr: false, so this is where the browser actually runs)
CORS_ORIGIN=http://localhost:3000
