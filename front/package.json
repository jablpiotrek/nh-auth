{
  "name": "front",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
