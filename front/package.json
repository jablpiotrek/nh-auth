    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@nordhealth/components": "^5.4.4",
    "@nordhealth/css": "^5.3.0",
    "@nordhealth/tokens": "^9.0.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@vue/devtools-api": "^8.2.1",
    "eslint": "^10.13.0",
    "nuxt": "^4.6.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/test-utils": "^2.5.1",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts,vue}": [
